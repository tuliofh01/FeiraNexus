# FeiraNexus API environment template.
# Copy to .env and fill in real values, or generate with: ./scripts/gen_env.sh

PORT=8080
GIN_MODE=debug

DATABASE_URL=postgres://feiranexus:feiranexus_dev_pass@localhost:5432/feiranexus_db?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=
AES_MASTER_KEY_HEX=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

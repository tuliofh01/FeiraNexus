@startuml
skinparam monochrome true
title FeiraNexus — PostgreSQL 17 ERD

entity "users" as users {
  * **id** : UUID PK <<gen_random_uuid()>>
  --
  * email : VARCHAR UNIQUE
  * password_hash : TEXT
  * role : VARCHAR <<'customer' | 'admin'>>
  stripe_customer_id : VARCHAR NULL
  * created_at : TIMESTAMPTZ <<now()>>
  * updated_at : TIMESTAMPTZ <<now()>>
}

entity "sessions" as sessions {
  * **id** : UUID PK <<gen_random_uuid()>>
  --
  * user_id : UUID FK --> users ON DELETE CASCADE
  * refresh_token_hash : VARCHAR UNIQUE
  user_agent : VARCHAR NULL
  client_ip : VARCHAR NULL
  * is_revoked : BOOLEAN DEFAULT false
  * expires_at : TIMESTAMPTZ
  * created_at : TIMESTAMPTZ
}

entity "products" as products {
  * **id** : UUID PK <<gen_random_uuid()>>
  --
  * name : VARCHAR
  description : TEXT NULL
  * price_cents : BIGINT CHECK(> 0)
  * currency : VARCHAR(3) DEFAULT 'usd'
  * stock_quantity : INT CHECK(>= 0)
  * is_active : BOOLEAN DEFAULT true
  * created_at : TIMESTAMPTZ
}

entity "orders" as orders {
  * **id** : UUID PK <<gen_random_uuid()>>
  --
  * user_id : UUID FK --> users
  * status : VARCHAR <<'pending' | 'paid' | 'failed' | 'canceled'>>
  * total_cents : BIGINT
  * currency : VARCHAR(3)
  stripe_payment_intent_id : VARCHAR UNIQUE NULL
  * created_at : TIMESTAMPTZ
}

entity "order_items" as order_items {
  * **id** : UUID PK <<gen_random_uuid()>>
  --
  * order_id : UUID FK --> orders ON DELETE CASCADE
  * product_id : UUID FK --> products
  * quantity : INT
  * unit_price_cents : BIGINT
}

users ||--o{ sessions : "owns"
users ||--o{ orders : "places"
orders ||--|{ order_items : "contains"
products ||--o{ order_items : "sold as"

note bottom of sessions
  refresh_token_hash stores only the
  SHA-256 hex digest of the token.
  Reuse of a revoked token triggers
  JobRevokeCompromisedUser.
end note

note bottom of orders
  stripe_payment_intent_id is UNIQUE
  (idempotent webhook processing).
  Written after PaymentIntent creation.
end note

note bottom of order_items
  unit_price_cents snapshots the price
  at checkout time (immutable history).
  DecrementProductStock uses
  SELECT ... FOR UPDATE on products.
end note
@enduml
